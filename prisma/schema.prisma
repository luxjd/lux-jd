generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Vehicle {
  id                 String          @id @default(uuid())
  status             VehicleStatus   @default(SOURCED)
  make               String          @db.VarChar(50)
  model              String          @db.VarChar(100)
  year               Int
  variant            String?         @db.VarChar(100)
  vin                String?         @unique @db.VarChar(17)
  driveSide          DriveSide
  mileageKm          Int?
  exteriorColor      String?         @db.VarChar(80)
  interiorColor      String?         @db.VarChar(80)
  specification      Json            @default("{}")
  engineSpec         String?
  auctionSource      String?         @db.VarChar(100)
  auctionGrade       Decimal?        @db.Decimal(2, 1)
  auctionLot         String?
  purchasePriceJpy   BigInt?
  fxRateAtPurchase   Decimal?        @db.Decimal(8, 4)
  landedCostEur      Decimal?        @db.Decimal(12, 2)
  estimatedSalePrice Decimal?        @db.Decimal(12, 2)
  listingPriceEur    Decimal?        @db.Decimal(12, 2)
  actualSalePrice    Decimal?        @db.Decimal(12, 2)
  marginEstimate     Decimal?        @db.Decimal(12, 2)
  marginActual       Decimal?        @db.Decimal(12, 2)
  marginConfidence   Decimal?        @db.Decimal(3, 2)
  conditionReport    Json            @default("{}")
  provenanceRecord   Json            @default("{}")
  riskFlags          String[]        @default([])
  costBreakdown      Json            @default("{}")
  documents          Json            @default("{}")
  photos             String[]        @default([])
  listingIds         Json            @default("{}")
  stageEnteredAt     DateTime?
  stageHistory       Json            @default("[]")
  estimatedReadyDate DateTime?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  leads              Lead[]
  listings           Listing[]
  pipelineEvents     PipelineEvent[]
  shipment           Shipment?
  transactions       Transaction[]
  tuvAppointment     TuvAppointment?
  valuations         Valuation[]

  @@index([make])
  @@index([model])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id              String              @id @default(uuid())
  vehicleId       String
  category        TransactionCategory
  amountEur       Decimal             @db.Decimal(12, 2)
  amountOriginal  Decimal?            @db.Decimal(12, 2)
  currency        String              @default("EUR") @db.VarChar(3)
  fxRate          Decimal?            @db.Decimal(8, 4)
  description     String?
  documentRef     String?             @db.VarChar(255)
  transactionDate DateTime            @default(now())
  createdAt       DateTime            @default(now())
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([category])
  @@index([transactionDate])
}

model MarketSnapshot {
  id              Int      @id @default(autoincrement())
  make            String   @db.VarChar(50)
  model           String   @db.VarChar(100)
  yearFrom        Int
  yearTo          Int
  avgPriceEur     Decimal  @db.Decimal(12, 2)
  medianPriceEur  Decimal  @db.Decimal(12, 2)
  minPrice        Decimal? @db.Decimal(12, 2)
  maxPrice        Decimal? @db.Decimal(12, 2)
  listingCount    Int
  avgDaysOnMarket Int?
  demandScore     Int?
  trend7d         Decimal? @db.Decimal(5, 2)
  trend30d        Decimal? @db.Decimal(5, 2)
  trend90d        Decimal? @db.Decimal(5, 2)
  specPremiums    Json     @default("{}")
  dataSource      String   @db.VarChar(50)
  snapshotAt      DateTime @default(now())

  @@index([make, model])
  @@index([snapshotAt])
}

model PipelineEvent {
  id         Int            @id @default(autoincrement())
  vehicleId  String
  fromStatus VehicleStatus?
  toStatus   VehicleStatus
  agent      String         @db.VarChar(50)
  message    String?
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now())
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([createdAt])
}

model Shipment {
  id                String    @id @default(uuid())
  vehicleId         String    @unique
  vesselName        String
  containerId       String
  containerType     String    @default("DEDICATED_20FT")
  originPort        String    @default("Yokohama")
  destinationPort   String    @default("Bremerhaven")
  carrier           String?
  departureDate     DateTime?
  estimatedArrival  DateTime?
  actualArrival     DateTime?
  insuranceProvider String?
  insurancePolicy   String?
  preShipPhotos     String[]  @default([])
  postArrivalPhotos String[]  @default([])
  damageDetected    Boolean   @default(false)
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])
}

model TuvAppointment {
  id              String    @id @default(uuid())
  vehicleId       String    @unique
  stationName     String
  stationCity     String
  appointmentDate DateTime?
  complexity      String    @default("LOW")
  estimatedCost   Decimal?  @db.Decimal(8, 2)
  passProbability Int?
  checklist       Json      @default("[]")
  result          String?
  notes           String?
  status          String    @default("SCHEDULED")
  createdAt       DateTime  @default(now())
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id])
}

model Listing {
  id              String        @id @default(uuid())
  vehicleId       String
  status          ListingStatus @default(DRAFT)
  currentPrice    Decimal       @db.Decimal(12, 2)
  initialPrice    Decimal       @db.Decimal(12, 2)
  pricingStrategy String?
  platforms       Json          @default("{}")
  content         Json          @default("{}")
  priceHistory    Json          @default("[]")
  daysOnMarket    Int           @default(0)
  totalViews      Int           @default(0)
  totalInquiries  Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([status])
}

model Lead {
  id               String     @id @default(uuid())
  vehicleId        String?
  name             String     @db.VarChar(200)
  email            String?    @db.VarChar(200)
  phone            String?    @db.VarChar(50)
  source           String     @db.VarChar(50)
  status           LeadStatus @default(NEW)
  buyerType        BuyerType  @default(UNKNOWN)
  score            Int        @default(0)
  language         String     @default("DE") @db.VarChar(5)
  inquiryText      String?
  responseText     String?
  offerPrice       Decimal?   @db.Decimal(12, 2)
  escalated        Boolean    @default(false)
  escalationReason String?
  suggestedAction  String?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  vehicle          Vehicle?   @relation(fields: [vehicleId], references: [id])
  messages         Message[]

  @@index([status])
  @@index([vehicleId])
  @@index([createdAt])
}

model Message {
  id        String   @id @default(uuid())
  leadId    String
  role      String   @db.VarChar(20)
  text      String
  source    String?  @db.VarChar(50)
  aiPowered Boolean  @default(false)
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

model Valuation {
  id             String   @id @default(uuid())
  vehicleId      String?
  make           String
  model          String
  year           Int
  inputData      Json
  reportData     Json
  verdict        String?  @db.VarChar(20)
  marginEur      Decimal? @db.Decimal(12, 2)
  confidence     Decimal? @db.Decimal(3, 2)
  aiPowered      Boolean  @default(false)
  processingTime Decimal? @db.Decimal(6, 1)
  createdAt      DateTime @default(now())
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([createdAt])
}

model OrchestratorDecision {
  id             String       @id @default(uuid())
  vehicleName    String
  opportunityId  String?
  decision       DecisionType
  decisionReason String
  steps          Json         @default("[]")
  financials     Json         @default("{}")
  risk           Json         @default("{}")
  portfolio      Json         @default("{}")
  brief          Json?
  flagReasons    String[]     @default([])
  createdAt      DateTime     @default(now())

  @@index([decision])
  @@index([createdAt])
}

model FxRate {
  id        Int      @id @default(autoincrement())
  rate      Decimal  @db.Decimal(8, 4)
  source    String   @default("frankfurter.app") @db.VarChar(50)
  live      Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FxAlert {
  id        Int      @id @default(autoincrement())
  level     String   @db.VarChar(20)
  type      String   @db.VarChar(50)
  message   String
  impact    String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model AgentStatus {
  id            String    @id
  name          String
  status        String    @default("IDLE")
  lastAction    String?
  lastActionAt  DateTime?
  errorCount24h Int       @default(0)
  metadata      Json      @default("{}")
  updatedAt     DateTime  @updatedAt
}

model KeyValueStore {
  key       String   @id @db.VarChar(255)
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  agent      String   @db.VarChar(50)
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(50)
  entityId   String?
  inputHash  String?  @db.VarChar(64)
  modelUsed  String?  @db.VarChar(100)
  tokensUsed Int?
  latencyMs  Int?
  reasoning  String?
  result     Json?
  createdAt  DateTime @default(now())

  @@index([agent])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Customer {
  id            String   @id
  name          String   @db.VarChar(200)
  email         String   @unique @db.VarChar(200)
  phone         String?  @db.VarChar(50)
  passwordHash  String   @db.VarChar(64)
  savedVehicles String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([email])
}

enum VehicleStatus {
  SOURCED
  PURCHASED
  JP_TRANSPORT
  AT_PORT_JP
  IN_TRANSIT
  AT_PORT_DE
  CUSTOMS
  WORKSHOP
  TUV
  READY_FOR_SALE
  LISTED
  RESERVED
  SOLD
  CANCELLED
}

enum DriveSide {
  LHD
  RHD
}

enum TransactionCategory {
  PURCHASE
  AUCTION_FEE
  TRANSPORT_JP
  EXPORT_DOCS
  FREIGHT
  INSURANCE
  CUSTOMS_DUTY
  IMPORT_VAT
  PORT_HANDLING
  TUV
  REGISTRATION
  TRANSPORT_DE
  DETAILING
  PHOTOGRAPHY
  LISTING_FEE
  STORAGE
  MISCELLANEOUS
  SALE_PROCEEDS
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD
  EXPIRED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ESCALATED
  VIEWING
  NEGOTIATING
  CONVERTED
  LOST
}

enum BuyerType {
  COLLECTOR
  SERIOUS
  TRADE
  BROWSER
  COMPETITOR
  UNKNOWN
}

enum DecisionType {
  AUTO_APPROVE
  HUMAN_REVIEW
  HUMAN_APPROVED
  HUMAN_REJECTED
  REJECT
}

